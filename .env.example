# Keep works with no configuration at all — without these it simply runs
# entirely in the browser, and a record can't be picked up on another
# machine. Set them to enable Keep codes across devices and share links.
#
# The anon key is safe to expose: the tables hold nothing but ciphertext,
# and the keys that open it never reach the server.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
